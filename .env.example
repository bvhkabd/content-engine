# ---------------------------------------------------------------------------
# Content Engine — environment
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Storage backend -------------------------------------------------------
# local  = tenants/ folder on this Mac + CSV files as the sheet (no Google auth
#          needed; best for first run, prompt iteration, and tests)
# google = Google Drive folder + real Google Sheet (source of truth in prod)
STORAGE_BACKEND=local

# Root folder for the local backend. Ignored when STORAGE_BACKEND=google.
TENANTS_DIR=./tenants

# --- LLM (required for session / approve / oracle) -------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# Swap the model without touching code.
OPENROUTER_MODEL=anthropic/claude-opus-4.1
# Optional: attribution headers OpenRouter shows on your dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=content-engine
# Optional: override the API base — for a proxy, a gateway, or a local mock
# when you want to exercise the loop without spending tokens.
OPENROUTER_BASE_URL=

# --- Google (required only when STORAGE_BACKEND=google) --------------------
# Path to a service-account JSON file, OR the raw JSON itself.
# The service account email must be granted access to the Drive folder AND
# the Sheet (share both with it, Editor).
GOOGLE_CREDENTIALS_JSON=/path/to/service-account.json
# Drive folder that contains the tenants/ tree. Overridable per tenant in
# tenant.yaml -> drive.root_folder_id
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Gmail source (oracle: #Postideas emails) ------------------------------
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=

# --- Fireflies (optional transcript source) --------------------------------
FIREFLIES_API_KEY=

# --- Outbound notifications (oracle summary, watchdog alerts) --------------
# Left blank => notifications are written to the log instead of emailed.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_TO=
